{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "TenantResolution": {
    "AllowHeaderFallback": false,
    "ExemptPathPrefixes": [
      "/health",
      "/swagger",
      "/openapi"
    ]
  },
  "Tenancy": {
    "MigrateTenantsOnStartup": false,
    "DatabaseServers": {},
    "SeedTenants": []
  },
  "ConnectionStrings": {
    "ControlPlane": ""
  },
  "ControlPlane": {
    "MigrateOnStartup": false,
    "RegistryRefreshInterval": "00:00:30"
  },
  "Licensing": {
    "TrustedKeys": [],
    "ClockRollbackTolerance": "00:10:00"
  },
  "EscalationMonitor": {
    "Enabled": true,
    "Interval": "00:00:15"
  },
  "UI": {
    "Enabled": false
  },
  "Authentication": {
    "Interactive": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "RequireHttpsMetadata": true,
      "Scopes": [],
      "SessionLifetime": "12:00:00"
    },
    "Jwt": {
      "Authority": "",
      "Audience": "",
      "Issuer": "",
      "SigningKeys": [],
      "RequireHttpsMetadata": true,
      "ClockSkew": "00:02:00"
    },
    "Claims": {
      "Tenant": "betsi:tenant_id",
      "Subject": "sub",
      "Role": "roles",
      "ActingRole": "betsi:acting_role"
    }
  },
  "Webhooks": {
    "AllowPrivateNetworkTargets": false,
    "AllowInsecureHttp": false,
    "DeliveryInterval": "00:00:10",
    "RequestTimeout": "00:00:10",
    "MaxAttempts": 8,
    "BatchSize": 50
  },
  "DataProtection": {
    "Store": "ControlPlane",
    "KeysDirectory": "",
    "CertificatePath": "",
    "CertificatePassword": ""
  },
  "Secrets": {
    "Directory": "/run/secrets"
  },
  "Observability": {
    "ServiceName": "betsi",
    "DeploymentEnvironment": "",
    "OtlpEndpoint": "",
    "TraceSampleRatio": 1.0
  }
}
