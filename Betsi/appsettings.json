{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "TenantResolution": {
    "AllowHeaderFallback": false,
    "ExemptPathPrefixes": [
      "/health",
      "/swagger",
      "/openapi"
    ]
  },
  "Tenancy": {
    "MigrateTenantsOnStartup": false,
    "DatabaseServers": {},
    "SeedTenants": []
  },
  "ConnectionStrings": {
    "ControlPlane": ""
  },
  "ControlPlane": {
    "MigrateOnStartup": false,
    "RegistryRefreshInterval": "00:00:30"
  },
  "Licensing": {
    "TrustedKeys": [],
    "ClockRollbackTolerance": "00:10:00"
  },
  "EscalationMonitor": {
    "Enabled": true,
    "Interval": "00:00:15"
  }
}
