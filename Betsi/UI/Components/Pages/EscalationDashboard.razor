@page "/"
@page "/escalations"
@using Betsi.Application.Commands
@using Betsi.Application.Escalations
@using Betsi.Domain.Aggregates
@using Betsi.Security
@using MediatR
@attribute [Authorize]
@inject UiScopeRunner Scope
@inject UiSession Session
@inject IStringLocalizer<Strings> T
@inject ILogger<EscalationDashboard> Logger

<PageTitle>@T["EscalationsTitle"]</PageTitle>

<RequirePermission Permission="@Permissions.EscalationsRead">

<h1>@T["EscalationsTitle"]</h1>
<p class="lede">@T["EscalationsSummary"]</p>

<LiveBoard OnChanged="LoadAsync" UpdatedAt="@(_board?.GeneratedAt ?? DateTime.UtcNow)" />

@if (_error is not null)
{
    <p class="notice notice--error" role="alert">@_error</p>
}
@if (_actionError is not null)
{
    <p class="notice notice--error" role="alert">@_actionError</p>
}

@if (_board is null)
{
    <p>@T["Loading"]</p>
}
else
{
    @* The policy banner is first and unmissable. A board with no policy raises nothing
       automatically, and a quiet board is indistinguishable from a quiet department. *@
    @if (_board.Policy.Status != "InForce")
    {
        <div class="notice notice--warning" role="alert">
            <h2>@T["NoPolicyTitle"]</h2>
            <p>@T["NoPolicyBody"]</p>
        </div>
    }
    else
    {
        <p class="policy-status">
            @T["PolicyInForce", _board.Policy.Revision!, Local(_board.Policy.EffectiveFrom!.Value)]
        </p>
    }

    <section aria-labelledby="awaiting-heading">
        <h2 id="awaiting-heading">
            @T["AwaitingAcknowledgement"] <span class="count">@_board.AwaitingAcknowledgement.Count</span>
        </h2>

        @if (_board.AwaitingAcknowledgement.Count == 0)
        {
            <p>@T["NothingAwaiting"]</p>
        }
        else
        {
            <div class="board-scroll" tabindex="0" role="region" aria-label="@T["AwaitingAcknowledgement"]">
            <table class="board">
                <caption class="visually-hidden">@T["AwaitingAcknowledgement"]</caption>
                <thead>
                    <tr>
                        <th scope="col">@T["ColumnPatient"]</th>
                        <th scope="col">@T["ColumnTier"]</th>
                        <th scope="col">@T["ColumnWaited"]</th>
                        <th scope="col">@T["ColumnResponsible"]</th>
                        <th scope="col">@T["ColumnDue"]</th>
                        <th scope="col">@T["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var card in _board.AwaitingAcknowledgement)
                    {
                        var action = ActionFor(card.Id);
                        <tr class="@(card.AcknowledgementOverdue ? "row--overdue" : null)">
                            <td>@PatientLink(card)</td>
                            <td>@(card.TierLevel?.ToString() ?? "—")</td>
                            <td>@Duration(card.WaitedMinutesWhenRaised ?? card.MinutesSinceRaised)</td>
                            <td>@card.ResponsibleRole</td>
                            <td>
                                @if (card.AcknowledgementOverdue)
                                {
                                    @* Conveyed in words as well as colour: a red row alone fails
                                       WCAG 1.4.1 and is invisible to a colour-blind clinician. *@
                                    <strong class="overdue">@T["Overdue"]</strong>
                                }
                                else if (card.AcknowledgementDueAt is { } due)
                                {
                                    @T["DueIn", Duration((int)Math.Max(0, (due - DateTime.UtcNow).TotalMinutes))]
                                }
                            </td>
                            <td>
                                @if (Session.Identity.Can(Permissions.EscalationsRespond))
                                {
                                    <button type="button" class="button"
                                            disabled="@_busy"
                                            @onclick="() => AcknowledgeAsync(card)">
                                        @T["Acknowledge"]
                                        <span class="visually-hidden">— @PatientName(card)</span>
                                    </button>
                                    <details class="inline-action">
                                        <summary>@T["Reassign"]</summary>
                                        <fieldset disabled="@(!_interactive || _busy)">
                                            <label for="@($"role-{card.Id}")">@T["ResponsibleRole"]</label>
                                            <input id="@($"role-{card.Id}")" @bind="action.ResponsibleRole" @bind:event="oninput" />
                                            <label for="@($"reason-{card.Id}")">@T["ReassignmentReason"]</label>
                                            <textarea id="@($"reason-{card.Id}")" @bind="action.Reason" @bind:event="oninput"></textarea>
                                            <button type="button" class="button button--quiet" @onclick="() => ReassignAsync(card, action)">@T["Reassign"]</button>
                                        </fieldset>
                                    </details>
                                    <button type="button" class="link-button" @onclick="() => ShowHistoryAsync(card.Id)">@T["ViewHistory"]</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </section>

    <section aria-labelledby="active-heading">
        <h2 id="active-heading">@T["ActiveEscalations"] <span class="count">@ActiveCards.Count</span></h2>

        @if (ActiveCards.Count == 0)
        {
            <p>@T["NothingActive"]</p>
        }
        else
        {
            <div class="board-scroll" tabindex="0" role="region" aria-label="@T["ActiveEscalations"]">
            <table class="board">
                <caption class="visually-hidden">@T["ActiveEscalations"]</caption>
                <thead>
                    <tr>
                        <th scope="col">@T["ColumnPatient"]</th>
                        <th scope="col">@T["ColumnTier"]</th>
                        <th scope="col">@T["ColumnResponsible"]</th>
                        <th scope="col">@T["ColumnRaised"]</th>
                        <th scope="col">@T["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var card in ActiveCards)
                    {
                        var action = ActionFor(card.Id);
                        <tr>
                            <td>@PatientLink(card)</td>
                            <td>@(card.TierLevel?.ToString() ?? "—")</td>
                            <td>@card.ResponsibleRole</td>
                            <td>@Duration(card.MinutesSinceRaised)</td>
                            <td>
                                @if (Session.Identity.Can(Permissions.EscalationsRespond))
                                {
                                    <button type="button" class="button"
                                            disabled="@_busy"
                                            @onclick="() => ResolveAsync(card)">
                                        @T["Resolve"]
                                        <span class="visually-hidden">— @PatientName(card)</span>
                                    </button>
                                    <details class="inline-action">
                                        <summary>@T["Reassign"]</summary>
                                        <fieldset disabled="@(!_interactive || _busy)">
                                            <label for="@($"role-{card.Id}")">@T["ResponsibleRole"]</label>
                                            <input id="@($"role-{card.Id}")" @bind="action.ResponsibleRole" @bind:event="oninput" />
                                            <label for="@($"reason-{card.Id}")">@T["ReassignmentReason"]</label>
                                            <textarea id="@($"reason-{card.Id}")" @bind="action.Reason" @bind:event="oninput"></textarea>
                                            <button type="button" class="button button--quiet" @onclick="() => ReassignAsync(card, action)">@T["Reassign"]</button>
                                        </fieldset>
                                    </details>
                                    <button type="button" class="link-button" @onclick="() => ShowHistoryAsync(card.Id)">@T["ViewHistory"]</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </section>

    <section aria-labelledby="followups-heading">
        <h2 id="followups-heading">@T["FollowUpExceptions"] <span class="count">@_board.FollowUpExceptions.Count</span></h2>

        @if (_board.FollowUpExceptions.Count == 0)
        {
            <p>@T["NoFollowUps"]</p>
        }
        else
        {
            <div class="board-scroll" tabindex="0" role="region" aria-label="@T["FollowUpExceptions"]">
            <table class="board">
                <caption class="visually-hidden">@T["FollowUpExceptions"]</caption>
                <thead>
                    <tr>
                        <th scope="col">@T["ColumnPatient"]</th>
                        <th scope="col">@T["ColumnOwner"]</th>
                        <th scope="col">@T["ColumnDue"]</th>
                        <th scope="col">@T["ColumnRaised"]</th>
                        <th scope="col">@T["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exception in _board.FollowUpExceptions)
                    {
                        var review = ReviewFor(exception.Id);
                        <tr class="row--overdue">
                            <td>@FollowUpPatientLink(exception)</td>
                            <td>@exception.OwnerRole</td>
                            <td>@Local(exception.MissedDeadline)</td>
                            <td>@Duration(exception.MinutesOpen)</td>
                            <td>
                                @if (Session.Identity.Can(Permissions.EscalationsRespond))
                                {
                                    <details class="inline-action">
                                        <summary>@T["CloseFollowUp"]</summary>
                                        <fieldset disabled="@(!_interactive || _busy)">
                                            <label for="@($"outcome-{exception.Id}")">@T["ReviewOutcome"]</label>
                                            <select id="@($"outcome-{exception.Id}")" @bind="review.Outcome">
                                                @foreach (var outcome in Enum.GetValues<FollowUpException.ReviewOutcome>()) { <option value="@outcome">@T[outcome.ToString()]</option> }
                                            </select>
                                            <label for="@($"review-{exception.Id}")">@T["ReviewNotes"]</label>
                                            <textarea id="@($"review-{exception.Id}")" @bind="review.Notes" @bind:event="oninput"></textarea>
                                            <button type="button" class="button" @onclick="() => CloseFollowUpAsync(exception, review)">@T["CloseFollowUp"]</button>
                                        </fieldset>
                                    </details>
                                    <button type="button" class="link-button" @onclick="() => ShowHistoryAsync(exception.EscalationId)">@T["ViewHistory"]</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </section>

    <section aria-labelledby="history-heading">
        <h2 id="history-heading">@T["RecentEscalationHistory"] <span class="count">@_board.History.Count</span></h2>
        @if (_board.History.Count == 0) { <p>@T["NoEscalationHistory"]</p> }
        else
        {
            <div class="board-scroll" tabindex="0" role="region" aria-label="@T["RecentEscalationHistory"]">
                <table class="board"><thead><tr><th>@T["ColumnPatient"]</th><th>@T["ColumnState"]</th><th>@T["ColumnResponsible"]</th><th>@T["ColumnRaised"]</th><th>@T["Actions"]</th></tr></thead>
                <tbody>@foreach (var card in _board.History) { <tr><td>@PatientLink(card)</td><td>@T[card.State]</td><td>@card.ResponsibleRole</td><td>@Local(card.CreatedAt)</td><td><button type="button" class="link-button" @onclick="() => ShowHistoryAsync(card.Id)">@T["ViewHistory"]</button></td></tr> }</tbody></table>
            </div>
        }
    </section>

    @if (_audit is not null)
    {
        <section class="audit-trail" aria-labelledby="audit-heading">
            <h2 id="audit-heading">@T["EscalationAuditTrail"]</h2>
            <table class="board"><thead><tr><th>@T["ColumnTime"]</th><th>@T["ColumnEvent"]</th><th>@T["ColumnActorRole"]</th></tr></thead>
            <tbody>@foreach (var entry in _audit) { <tr><td>@entry.OccurredAt.ToLocalTime().ToString("g")</td><td>@T[entry.EventType]</td><td>@entry.ActorRole</td></tr> }</tbody></table>
        </section>
    }
}

</RequirePermission>

@code {
    private EscalationBoard? _board;
    private string? _error;
    private string? _actionError;
    private bool _busy;
    private bool _interactive;
    private IReadOnlyList<AuditTrailEntry>? _audit;
    private readonly Dictionary<Guid, EscalationActionModel> _actions = [];
    private readonly Dictionary<Guid, FollowUpReviewModel> _reviews = [];
    // The API's Active list includes every unresolved escalation. The UI's second section
    // is for those already acknowledged; a Created escalation cannot be resolved yet.
    private IReadOnlyList<EscalationCard> ActiveCards => _board?.Active
        .Where(card => card.State is "Acknowledged" or "Escalated").ToList() ?? [];

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { _interactive = true; StateHasChanged(); }
        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        await Session.EnsureAsync();

        // The guard renders a refusal instead of this page, but a callback from a live update
        // could still arrive: a board that cannot be read must not be fetched.
        if (!Session.IsResolved || !Session.Identity.Can(Permissions.EscalationsRead))
            return;

        try
        {
            _board = await Scope.RunAsync(services =>
                services.GetRequiredService<EscalationQueries>().GetBoardAsync(historyDays: 1, CancellationToken.None));
            _error = null;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Escalation board refresh failed");
            _error = T["BoardRefreshFailed"];
        }
    }

    private Task AcknowledgeAsync(EscalationCard card) =>
        SendAsync(new AcknowledgeEscalationCommand { EscalationId = card.Id }, $"{T["Acknowledge"]} — {PatientName(card)}");

    private Task ResolveAsync(EscalationCard card) =>
        SendAsync(new ResolveEscalationCommand { EscalationId = card.Id }, $"{T["Resolve"]} — {PatientName(card)}");

    private Task ReassignAsync(EscalationCard card, EscalationActionModel action) =>
        SendAsync(new ReassignEscalationCommand { EscalationId = card.Id, ResponsibleRole = action.ResponsibleRole, Reason = action.Reason }, $"{T["Reassign"]} — {PatientName(card)}");

    private Task CloseFollowUpAsync(FollowUpExceptionCard exception, FollowUpReviewModel review) =>
        SendAsync(new CloseFollowUpExceptionCommand { FollowUpExceptionId = exception.Id, Outcome = review.Outcome, ReviewNotes = review.Notes }, $"{T["FollowUpExceptions"]} — {exception.Patient?.Name ?? "—"}");

    private async Task ShowHistoryAsync(Guid escalationId)
    {
        try
        {
            _audit = await Scope.RunReadAsync("EscalationAuditTrail", escalationId, services =>
                services.GetRequiredService<EscalationQueries>().GetAuditTrailAsync(escalationId, CancellationToken.None));
            _actionError = null;
        }
        catch (Exception exception) { Logger.LogError(exception, "Escalation history load failed for {EscalationId}", escalationId); _actionError = UiActionFeedback.For(exception, T["ViewHistory"], T); }
    }

    /// <summary>
    /// Every action goes through the same audited, validated command the API exposes. The UI
    /// has no privileged path of its own: permissions, licence rules and the audit trail apply
    /// exactly as they would to an integration.
    /// </summary>
    private async Task SendAsync(ICommand command, string subject)
    {
        _busy = true;
        _actionError = null;
        try
        {
            await Scope.RunAsync(services => services.GetRequiredService<ISender>().Send(command));
            _error = null;
        }
        catch (Exception exception)
        {
            // Refreshing the data must not erase the failed action's feedback.
            Logger.LogError(exception, "Escalation action failed for {Subject}", subject);
            _actionError = UiActionFeedback.For(exception, subject, T);
        }
        finally
        {
            _busy = false;
        }

        // Refetched rather than patched in memory: the command may have raised a follow-up
        // exception or changed another row, and the board is cheap to re-read.
        await LoadAsync();
    }

    private string PatientName(EscalationCard card) => card.Patient?.Name ?? "—";

    private RenderFragment PatientLink(EscalationCard card) => builder =>
    {
        if (card.Patient is not { } patient) { builder.AddContent(0, "—"); return; }
        builder.OpenElement(0, "a"); builder.AddAttribute(1, "href", UiRoutes.Episode(patient.EpisodeId)); builder.AddContent(2, patient.Name); builder.CloseElement();
    };

    private RenderFragment FollowUpPatientLink(FollowUpExceptionCard exception) => builder =>
    {
        if (exception.Patient is not { } patient) { builder.AddContent(0, "—"); return; }
        builder.OpenElement(0, "a"); builder.AddAttribute(1, "href", UiRoutes.Episode(patient.EpisodeId)); builder.AddContent(2, patient.Name); builder.CloseElement();
    };

    private EscalationActionModel ActionFor(Guid id)
    {
        if (!_actions.TryGetValue(id, out var action)) _actions[id] = action = new();
        return action;
    }

    private FollowUpReviewModel ReviewFor(Guid id)
    {
        if (!_reviews.TryGetValue(id, out var review)) _reviews[id] = review = new();
        return review;
    }

    private static string Local(DateTime utc) => utc.ToLocalTime().ToString("HH:mm");

    private string Duration(int minutes) =>
        minutes < 60 ? T["Minutes", minutes] : T["HoursMinutes", minutes / 60, minutes % 60];

    private sealed class EscalationActionModel { public string ResponsibleRole { get; set; } = string.Empty; public string Reason { get; set; } = string.Empty; }
    private sealed class FollowUpReviewModel { public FollowUpException.ReviewOutcome Outcome { get; set; } = FollowUpException.ReviewOutcome.AcknowledgedLate; public string Notes { get; set; } = string.Empty; }
}
