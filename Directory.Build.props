<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      NU1608 (dependency-constraint violation) and NU1902/NU1903 (known vulnerabilities)
      are escalated to errors so the package-hygiene problems fixed in Phase A cannot
      silently regress.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1608;NU1902;NU1903</WarningsAsErrors>
  </PropertyGroup>

</Project>
