{
  "realm": "betsi",
  "enabled": true,
  "displayName": "Betsi Patient Flow (development)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "accessTokenLifespan": 3600,
  "clients": [
    {
      "clientId": "betsi-ui",
      "name": "Betsi web interface",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "betsi-ui-development-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:5080/*",
        "http://127.0.0.1:8080/*",
        "http://localhost:5080/*",
        "http://localhost:8080/*",
        "https://localhost:7080/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:5080",
        "http://127.0.0.1:8080",
        "http://localhost:5080",
        "http://localhost:8080",
        "https://localhost:7080"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://127.0.0.1:5080/*##http://127.0.0.1:8080/*##http://localhost:5080/*##http://localhost:8080/*##https://localhost:7080/*"
      },
      "protocolMappers": [
        {
          "name": "betsi tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "betsi_tenant_id",
            "claim.name": "betsi:tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "betsi roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "betsi_roles",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true"
          }
        },
        {
          "name": "betsi acting role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "betsi_acting_role",
            "claim.name": "betsi:acting_role",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "betsi-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "betsi-api",
      "name": "Betsi API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "betsi-api-development-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {}
    }
  ],
